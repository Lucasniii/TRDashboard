# Provider credentials. Copy to .env.local and fill in.
# Phase 1 runs on mock data and needs none of these.

# Pins the base URL used to build the OAuth redirect_uri. Without it the URI is
# derived from the incoming request, so opening the app at 127.0.0.1 instead of
# localhost produces a URI the provider has not registered and the sign-in fails.
STRWO_BASE_URL=http://localhost:3000

# Which repository the app reads from: "mock" (default) or "supabase"
STRWO_DATA_SOURCE=mock

# https://developer.whoop.com — redirect URI http://localhost:3000/api/auth/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# https://developers.wahooligan.com/applications/new — redirect URI http://localhost:3000/api/auth/wahoo/callback
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Supabase (Phase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
