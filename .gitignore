# production data / local state
# Only ignore the runtime store at the repository root. A bare `data/` pattern
# also matched `src/lib/data`, which meant the application's repository layer
# could never be committed.
/data/

# environment
.env
.env.local
.env*.local
# The template is meant to be committed; keep it visible if the block above
# is ever widened to .env* again.
!.env.example

